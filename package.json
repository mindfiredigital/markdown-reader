{
  "name": "markdown-reader",
  "version": "1.0.3",
  "description": "A markdown reader built with Electron",
  "main": "out/main/index.js",
  "scripts": {
    "prepare": "husky",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "pnpm build && electron-builder --publish never",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "changeset:auto": "node .github/create-auto-changeset.js",
    "changeset:version": "node .github/changeset-version.js",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "build:extension": "vite build --config vite.extension.config.ts"
  },
  "keywords": [],
  "author": "Mindfire-digital",
  "contributors": [],
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "^5.2.0",
    "buffer": "^6.0.3",
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1",
